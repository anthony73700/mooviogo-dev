# App
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
APP_ENV=development
APP_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgres://mooviogo:mooviogo@localhost:5432/mooviogo

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Auth
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio (OTP / SMS / WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=

# Web Push (VAPID)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_CLAIMS_SUBJECT=mailto:hello@mooviogo.com

# OAuth Apple
APPLE_CLIENT_ID=

# Geocoding / maps
GEOCODING_ENABLED=True
GEOCODING_PROVIDER=nominatim
GEOCODING_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=mooviogo/1.0 (hello@mooviogo.com)

# Google Maps API (carte interactive — laisse vide pour utiliser un fallback OpenStreetMap)
GOOGLE_MAPS_API_KEY=

# OpenAI (recommandations, génération contenu, marketing auto)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20

# Cloudflare Turnstile (anti-bot signup — laisse vide pour désactiver)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (consent-gated in UI)
ENABLE_ANALYTICS=False
GA4_MEASUREMENT_ID=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
META_PIXEL_ID=
TIKTOK_PIXEL_ID=

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@mooviogo.com

# Data encryption (Fernet) — leave empty in dev (derived from SECRET_KEY)
DATA_ENCRYPTION_KEY=
