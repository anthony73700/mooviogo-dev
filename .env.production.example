# ─── Mooviogo PRODUCTION env template ─────────────────────────────────────────
# Copy to .env.production and fill in real values.
# Generate secrets via: python scripts/generate_prod_secrets.py
# Never commit the filled file.

# Core
SECRET_KEY=                           # 64+ random chars, generate
DEBUG=False
APP_ENV=production
ALLOWED_HOSTS=mooviogo.com,www.mooviogo.com
APP_BASE_URL=https://mooviogo.com
DJANGO_SETTINGS_MODULE=mooviogo.settings.production

# Encryption (Fernet)
DATA_ENCRYPTION_KEY=                  # generate via manage.py generate_encryption_key

# Database (use managed Postgres; require SSL)
DATABASE_URL=postgres://user:password@host:5432/mooviogo?sslmode=require
POSTGRES_DB=mooviogo
POSTGRES_USER=mooviogo
POSTGRES_PASSWORD=

# Redis / Celery / Channels
REDIS_URL=rediss://default:password@host:6379/0

# CORS / CSRF
CORS_ALLOWED_ORIGINS=https://mooviogo.com,https://www.mooviogo.com
CSRF_TRUSTED_ORIGINS=https://mooviogo.com,https://www.mooviogo.com

# Auth / JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=30

# Stripe (LIVE keys)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=+33...
TWILIO_FROM_WHATSAPP=whatsapp:+33...

# Web Push (VAPID) — generate via scripts/generate_prod_secrets.py
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_CLAIMS_SUBJECT=mailto:contact@mooviogo.com

# OAuth Apple (optional)
APPLE_CLIENT_ID=

# Geocoding / Maps
GEOCODING_ENABLED=True
GEOCODING_PROVIDER=nominatim
GEOCODING_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=mooviogo/1.0 (contact@mooviogo.com)
GOOGLE_MAPS_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics
ENABLE_ANALYTICS=True
GA4_MEASUREMENT_ID=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
META_PIXEL_ID=
TIKTOK_PIXEL_ID=

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Mooviogo <noreply@mooviogo.com>

# Object storage (S3 / Cloudflare R2) — leave empty to keep local FS
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=                  # e.g. https://<accountid>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=                 # e.g. media.mooviogo.com
AWS_QUERYSTRING_AUTH=False

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Gunicorn tuning (optional overrides)
GUNICORN_WORKERS=
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
