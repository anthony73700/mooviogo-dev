[Unit]
Description=Mooviogo ASGI (daphne, websockets)
After=network.target redis.service
Requires=network.target

[Service]
Type=simple
User=mooviogo
Group=mooviogo
WorkingDirectory=/opt/mooviogo
EnvironmentFile=/opt/mooviogo/.env.production
Environment=DJANGO_SETTINGS_MODULE=mooviogo.settings.production
ExecStart=/opt/mooviogo/.venv/bin/daphne -b 127.0.0.1 -p 8001 mooviogo.asgi:application
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
