{
  "name": "mooviogo-web",
  "version": "0.1.0",
  "private": true,
  "description": "Tailwind build pipeline for Mooviogo Django templates",
  "scripts": {
    "build:css": "tailwindcss -i ./apps/web/static/src/mooviogo.css -o ./apps/web/static/dist/mooviogo.css --minify",
    "watch:css": "tailwindcss -i ./apps/web/static/src/mooviogo.css -o ./apps/web/static/dist/mooviogo.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/aspect-ratio": "^0.4.2"
  }
}
